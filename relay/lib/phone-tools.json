[
  {
    "name": "phone_status",
    "description": "Read this phone's Android/build, battery and Magisk root identity. Executes locally on the phone; no PC or ADB.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    }
  },
  {
    "name": "read_ui",
    "description": "Read fresh UI nodes with bounds; wakes the screen, redacts password fields and secret URLs. If UI animation prevents a dump, use screenshot. Never bypass secure lock screens.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 120
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    }
  },
  {
    "name": "screenshot",
    "description": "Return this phone's current screen as a PNG image; may contain private information. Use only for the user's requested task.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    }
  },
  {
    "name": "tap",
    "description": "Tap a phone coordinate derived from a fresh UI dump or screenshot. Wakes without unlocking a secure keyguard.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false
    }
  },
  {
    "name": "swipe",
    "description": "Swipe using fresh phone screen coordinates.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "x1": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "y1": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "x2": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "y2": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 50,
          "maximum": 10000,
          "default": 300
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false
    }
  },
  {
    "name": "keypress",
    "description": "Send a supported phone hardware/navigation key.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
